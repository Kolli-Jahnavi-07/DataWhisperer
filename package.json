{
  "name": "datawhisperer",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Profile any CSV instantly in your browser with DuckDB-WASM: column types, missing values, statistics, data quality checks, and generated dbt tests.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@duckdb/duckdb-wasm": "1.32.0",
    "apache-arrow": "^17.0.0"
  },
  "devDependencies": {
    "@playwright/test": "1.49.1",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^2.1.0"
  }
}
